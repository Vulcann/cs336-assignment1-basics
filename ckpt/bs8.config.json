{
  "run_name": "bs8",
  "log_dir": "logs",
  "ckpt_dir": "ckpt",
  "train_path": "data/train.bin",
  "val_path": "data/val.bin",
  "tokenizer_path": "artifacts/tokenizer.json",
  "device": "cuda:0",
  "batch_size": 8,
  "context_length": 256,
  "max_iters": 10000,
  "max_l2_norm": 1.0,
  "log_interval": 50,
  "eval_interval": 500,
  "eval_batches": 20,
  "ckpt_interval": 1000,
  "resume": "",
  "model": {
    "vocab_size": 10000,
    "num_layers": 4,
    "d_model": 512,
    "num_heads": 16,
    "d_ff": 1344,
    "max_seq_len": 256,
    "theta": 10000.0
  },
  "optim": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "betas": [
      0.9,
      0.95
    ],
    "eps": 1e-08
  },
  "schedule": {
    "max_learning_rate": 0.0005,
    "min_learning_rate": 5e-05,
    "warmup_iters": 200,
    "cosine_cycle_iters": 10000
  },
  "decode": {
    "temperature": 0.8,
    "sampling_p": 0.9,
    "max_new_tokens": 256
  }
}