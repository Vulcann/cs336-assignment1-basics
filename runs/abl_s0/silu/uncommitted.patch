+class FFN(nn.Module):
+    """W2(SiLU(W1 x)) —— 去掉门控的那一版，用来和 SwiGLU 做等参数量对照。"""
+
+    def __init__(self, d_model: int, d_ff: int):
+        super().__init__()
+        self.w1 = Linear(d_model, d_ff)
+        self.w2 = Linear(d_ff, d_model)
+        self.silu = SiLU()
+
+    def forward(self, x):
+        return self.w2(self.silu(self.w1(x)))
+
